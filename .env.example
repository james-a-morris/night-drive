# Server only. Never add this key to src/, HTML, or public build files.
OPENROUTER_API_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Neon/PostgreSQL connection URL, preferably pooled, with the provider's SSL settings.
# Required on Vercel; also selects PostgreSQL for local development.
DATABASE_URL=
# Optional additional trusted origin. The current deployment's origin is accepted too.
APP_ORIGIN=
# Local development defaults to SQLite in .data/night-drive.sqlite.
# Override the port in the shell: PORT=3000 pnpm dev
