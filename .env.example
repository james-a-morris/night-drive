# Server only. Never add this key to src/, HTML, or public build files.
OPENROUTER_API_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Required for a persistent shared leaderboard on Vercel. Use a pooled PostgreSQL URL.
DATABASE_URL=
# Public origin for auth and social preview URLs, e.g. https://night-drive.example.com.
# Social previews use the Vercel production/deployment URL when unset.
# Set this for self-hosted production deployments.
APP_ORIGIN=
# Local development defaults to SQLite in .data/night-drive.sqlite.
# Override the port in the shell: PORT=3000 pnpm dev
