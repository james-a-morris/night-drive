# Server only. Never add this key to src/, HTML, or public build files.
OPENROUTER_API_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional when Clerk is disabled, or to keep rate-limit hashes stable across key rotation.
# Generate a long random server-only value; never expose it to browser code.
RATE_LIMIT_SECRET=
# Required for a persistent shared leaderboard on Vercel. Use a pooled PostgreSQL URL.
DATABASE_URL=
# Public origin for auth and social preview URLs, e.g. https://night-drive.example.com.
# Social previews use the Vercel production/deployment URL when unset.
# Required for self-hosted production deployments. Forwarded host headers are not trusted.
APP_ORIGIN=
# Self-hosted behind a proxy: a header it overwrites with the visitor's IP, e.g. x-real-ip.
# Without it, every visitor shares one rate limit. Vercel needs nothing here.
CLIENT_IP_HEADER=
# Local development defaults to SQLite in .data/night-drive.sqlite.
# Override the port in the shell: PORT=3000 pnpm dev

# Optional: show the Dev kit toggle and allow the diagnostics panel.
# Hidden unless exactly true. Restart dev or rebuild production after changing.
NEXT_PUBLIC_ENABLE_DEV_KIT=false
